<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="page-title mb-0">Backup Αρχεία: {{job.name}}</h2>
        <small class="text-muted">{{job.host}}:{{job.port}} / {{job.dbName}}</small>
    </div>
    <div class="d-flex gap-2">
        <a href="/databases/{{job.id}}" class="btn btn-outline-primary btn-sm">✏️ Επεξεργασία</a>
        <a href="/dashboard" class="btn btn-outline-secondary btn-sm">← Dashboard</a>
    </div>
</div>

{{#if error}}
<div class="alert alert-danger">{{error}}</div>
{{/if}}

<div class="card">
    <div class="card-body p-0">
        {{#if files.length}}
        <div class="table-responsive">
            <table class="table table-hover mb-0" id="files-table">
                <thead>
                    <tr>
                        <th>Αρχείο</th>
                        <th>Ημερομηνία</th>
                        <th>Μέγεθος</th>
                        <th>Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each files}}
                    <tr>
                        <td class="font-monospace">{{this.name}}</td>
                        <td>{{datetime this.createdAt}}</td>
                        <td>{{formatBytes this.size}}</td>
                        <td class="actions-col">
                            <a href="/databases/{{../job.id}}/storage/{{this.name}}/download"
                               class="btn btn-sm btn-outline-primary" title="Λήψη">
                                ⬇️
                            </a>
                            <form method="POST" action="/databases/{{../job.id}}/storage/{{this.name}}/delete"
                                  class="d-inline"
                                  onsubmit="return confirm('Διαγραφή του αρχείου {{this.name}};')">
                                <button type="submit" class="btn btn-sm btn-outline-danger ms-1" title="Διαγραφή">
                                    🗑️
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="text-center text-muted py-5">
            <p>Δεν υπάρχουν backup αρχεία για αυτό το job.</p>
            <small>Εκτελέστε <code>npm run backup:all</code> για να πάρετε το πρώτο backup.</small>
        </div>
        {{/if}}
    </div>
</div>
